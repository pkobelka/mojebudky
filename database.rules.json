{
  "rules": {
    ".read": false,
    ".write": false,
    "aquactrl_udalosti": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ( auth.token.admin === true || (newData.exists() && (data.exists() || newData.child('zadal').val() === auth.token.person)) )"
      }
    },
    "aquactrl_ukoly": {
      ".read": "auth != null",
      ".indexOn": [
        "resitel",
        "stav"
      ],
      "$id": {
        ".write": "auth != null && ( auth.token.admin === true || (!data.exists() && newData.child('zadal').val() === auth.token.person) || (data.exists() && (data.child('zadal').val() === auth.token.person || data.child('resitel').val() === auth.token.person)) )"
      }
    },
    "aquactrl_absence": {
      ".read": "auth != null",
      "$kdo": {
        ".write": "auth != null && (auth.token.person === $kdo || auth.token.admin === true)"
      }
    },
    "aquactrl_zarizeni": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "aquactrl_presence": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "aquactrl_push_tokens": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "aquactrl_outbox": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "aquactrl_login_email": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true"
    },
    "florian_kandidati": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "florian_domereni": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "florian_foto": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "florian_ukoly": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "florian_lide": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true"
    },
    "florian_push_tokens": {
      ".read": false,
      "$dev": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['token'])"
      }
    },
    "florian_zarizeni": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "florian_outbox": {
      ".read": false,
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['title', 'uid', 'ts'])"
      }
    },
    "florian_gis_requests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "florian_presence": {
      ".read": "auth != null",
      "$dev": {
        ".write": "auth != null"
      }
    },
    "florian_seq": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.isNumber()"
    },
    "florian_login_email": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true"
    },
    "florian_revize": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true"
    },
    "florian_config": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true"
    },
    "florian_pairing": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.admin === true"
      }
    },
    "presence": {
      ".read": true,
      ".write": true
    },
    "aktivita": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": [
        "ts"
      ]
    },
    "aktuality": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      ".indexOn": [
        "ts"
      ]
    },
    "budky_edit": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      "$cislo": {
        ".write": "auth != null"
      }
    },
    "admin_requests": {
      ".read": "auth != null && auth.token.admin === true",
      "$typ": {
        "$id": {
          ".write": "!data.exists() || (auth != null && auth.token.admin === true)"
        }
      }
    },
    "spravci": {
      "$loginId": {
        ".read": "auth != null && (auth.token.loginId === $loginId || auth.token.admin === true)",
        ".write": "auth != null && (auth.token.loginId === $loginId || auth.token.admin === true)"
      }
    },
    "spravce_aktivita": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      "$cislo": {
        ".write": "auth != null"
      }
    },
    "prihlaseni": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null"
    },
    "navstevnost_log": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": true
      },
      ".indexOn": [
        "ts"
      ]
    },
    "navstevnost_celkem": {
      ".read": true,
      ".write": true
    },
    "navstevnost_denne": {
      ".read": true,
      ".write": true
    },
    "push_broadcast": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "push_history": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "auth != null && auth.token.admin === true",
        "read": {
          "$loginId": {
            ".write": "auth != null"
          }
        }
      }
    },
    "push_tokens": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": true
      }
    },
    "budky_login": {
      "$req": {
        ".write": "!newData.exists()",
        "req": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['loginId', 'heslo']) && newData.child('loginId').isString() && newData.child('loginId').val().length <= 32 && newData.child('heslo').isString() && newData.child('heslo').val().length <= 200"
        },
        "res": {
          ".read": true
        }
      }
    },
    "budky_kontakty": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !newData.exists()",
        "req": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()"
        }
      }
    },
    "budky_passwd": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !newData.exists()",
        "req": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChild('nove') && newData.child('nove').isString() && newData.child('nove').val().length <= 200"
        }
      }
    },
    "zpravy_spravci": {
      "$loginId": {
        ".read": "auth != null && (auth.token.loginId === $loginId || auth.token.admin === true)",
        ".write": "auth != null && (auth.token.loginId === $loginId || auth.token.admin === true)"
      }
    },
    "volby_obce": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}